# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Lead gen tool → this app
# Use same value as Lead Gen Auto's MESSAGING_TOOL_API_KEY for webhook auth
LEAD_GEN_INTEGRATION_TOKEN=your-secret-token
LEAD_GEN_API_TOKEN=your-secret-token

# Sender service (GET /api/sender/queue, mark-sent, mark-failed, reply)
SENDER_SERVICE_TOKEN=your-sender-secret

# Sender behavior (same as previous desktop app: working hours, human-like delays, pauses, recontact)
SENDER_WORKING_START=10:00
SENDER_WORKING_END=18:00
SENDER_DELAY_MIN=60
SENDER_DELAY_MAX=210
SENDER_SHORT_PAUSE_EVERY=15
SENDER_SHORT_PAUSE_MIN=15
SENDER_LONG_PAUSE_EVERY=50
SENDER_LONG_PAUSE_MIN=30
SENDER_RECONTACT_SKIP_DAYS=3

# OpenAI (message generation)
OPENAI_API_KEY=sk-...

# Resend (email)
RESEND_API_KEY=re_...
OUTREACH_FROM_EMAIL=Outreach <contato@yourdomain.com>
OUTREACH_REPLY_TO=contato@yourdomain.com
OUTREACH_EMAIL_SUBJECT=Uma oportunidade para sua clínica
