# Copy to .env and fill in
API_BASE_URL=https://your-outreach-app.vercel.app

# Service token from admin panel (SDRs page > "Generate service token")
# Using an admin service token processes messages for ALL SDRs centrally.
# SDRs don't need to run anything -- just create them in the admin panel.
SENDER_SERVICE_TOKEN=your_service_token_from_admin_panel

# Optional: delay between messages (seconds) - random range
MIN_DELAY_BETWEEN_MESSAGES=30
MAX_DELAY_BETWEEN_MESSAGES=90

# Optional: delay before pasting message (seconds) - wait for chat to open
WAIT_AFTER_OPEN_CHAT=3

# Optional: paste character delay (seconds) - simulates typing (0 = paste in one go)
TYPING_DELAY_PER_CHAR=0
